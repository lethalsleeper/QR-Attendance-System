{
  "name": "qr-attendance-functions",
  "description": "Cloud Functions for the QR Attendance System (registration, sessions, attendance validation)",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/",
    "test:unit": "node --test test/unit/",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-qr-attendance \"node --test --test-concurrency=1 test/\"",
    "serve": "firebase emulators:start --project demo-qr-attendance",
    "deploy": "firebase deploy --only functions",
    "invite-teacher": "node scripts/invite-teacher.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
