<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme used before Compose draws its first frame. The indigo window
         background makes the cold start blend into the Compose splash screen. -->
    <style name="Theme.QRAttendance" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_indigo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
