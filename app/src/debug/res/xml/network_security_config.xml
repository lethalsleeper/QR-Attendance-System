<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the Firebase Emulator Suite speaks plain HTTP, and the emulator host
     can be any LAN IP (-PfirebaseEmulatorHost), so cleartext is allowed here. This file
     overrides src/main/res/xml/network_security_config.xml for the debug build type;
     release builds stay HTTPS-only. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
